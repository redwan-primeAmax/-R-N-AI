# AI Studio Environment Variables
# The app uses these on the server-side proxy routes

# Gemini API Key (Required for AI features if user hasn't provided their own)
# Obtain from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional: Other AI Providers
OPENROUTER_API_KEY=
FIREWORKS_API_KEY=
OPENAI_API_KEY=

# App Settings
NODE_ENV=development
PORT=3000
